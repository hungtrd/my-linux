[init]
  defaultBranch = master
[user]
  email = hungtranduy.dev@gmail.com
  name = hungtrd
[core]
  editor = vim
[alias]
  s = status
  ci = commit
  br = branch
  co = checkout
  df = diff
  lg = log -p
  ps = push
  pl = pull
  wt = worktree
  cb  = "!f(){ git checkout -b $1;};f"
[url "ssh://git@git.ocn.com.vn/"]
	insteadOf = https://git.ocn.com.vn/
[url "git@git.ocn.com.vn:"]
	insteadOf = https://git.ocn.com.vn/

[includeIf "gitdir:**/workspace/company/ocn/**"]
	path = ~/.config/git/config-ocn
